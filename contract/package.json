{
  "name": "muri-protocol",
  "description": "Solidity contracts for MURI Protocol",
  "version": "1.0.0",
  "dependencies": {
    "@manifoldxyz/creator-core-solidity": "3.0.0",
    "@manifoldxyz/libraries-solidity": "1.0.4",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6",
    "solady": "0.0.254"
  },
  "devDependencies": {
    "forge-std": "github:foundry-rs/forge-std#bb4ceea94d6f10eeb5b41dc2391c6c8bf8e734ef",
    "prettier": "3.1.1",
    "solhint": "3.6.2"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "forge",
    "foundry",
    "smart-contracts",
    "solidity"
  ],
  "private": true,
  "scripts": {
    "clean": "rm -rf cache out",
    "build": "forge build",
    "lint": "pnpm run lint:sol && pnpm run prettier:check",
    "lint:sol": "forge fmt --check && solhint \"{script,src,test}/**/*.sol\"",
    "prettier:check": "prettier --check \"**/*.{json,md,yml}\" --ignore-path \".prettierignore\"",
    "prettier:write": "prettier --write \"**/*.{json,md,yml}\" --ignore-path \".prettierignore\"",
    "test": "forge test",
    "test:coverage": "forge coverage",
    "test:coverage:report": "forge coverage --report lcov && genhtml lcov.info --branch-coverage --output-dir coverage",
    "test:template": "node html-template/test-template.js",
    "test:template:save": "node html-template/test-template.js --save",
    "minify": "node html-template/minify-template.js",
    "minify:stats": "node html-template/minify-template.js --stats"
  },
  "packageManager": "pnpm@10.8.0+sha512.0e82714d1b5b43c74610193cb20734897c1d00de89d0e18420aebc5977fa13d780a9cb05734624e81ebd81cc876cd464794850641c48b9544326b5622ca29971"
}
